#define CUSTOM_SETTINGS;

const int st_in1 = 16; //steering motor driver pins defined
const int st_in2 = 17;
const int right_in1 = 18; //drive motor pins defined
const int right_in2 = 19;
const int left_in1 = 22;
const int left_in2 = 23;
const int stby = 34;

void setup() {
  pinMode(stby, OUTPUT);
  digitalWrite(stby, HIGH);
  pinMode(st_in1,OUTPUT);
  pinMode(st_in2,OUTPUT);
  pinMode(right_in1,OUTPUT);
  pinMode(right_in2,OUTPUT);
  pinMode(left_in1,OUTPUT);
  pinMode(left_in2,OUTPUT);
}

void loop() {
  digitalWrite(st_in1, HIGH);
  digitalWrite(st_in2, LOW);
  delay(2000);
  digitalWrite(st_in1, LOW);
  digitalWrite(st_in2, HIGH);
  delay(2000);
  digitalWrite(right_in1, HIGH);
  digitalWrite(right_in2, LOW);
  delay(2000);
  digitalWrite(right_in1, LOW);
  digitalWrite(right_in2, HIGH);
  delay(2000);
  digitalWrite(left_in1, HIGH);
  digitalWrite(left_in2, LOW);
  delay(2000);
  digitalWrite(left_in1, LOW);
  digitalWrite(left_in2, HIGH);
  delay(2000);
}
